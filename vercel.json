{
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "destination": "/",
      "source": "/modern-atasehir-pilot.html",
      "permanent": false
    },
    {
      "permanent": false,
      "destination": "/",
      "source": "/modern-atasehir-pilot"
    }
  ]
}
